	&lt;element name="Ammunition of Aberration Slaying" type="Magic Item" source="Dungeon Master’s Guide (2024)" id="ID_WOTC_DMG24_MAGIC_ITEM_AMMUNITION_OF_ABERRATION_SLAYING"&gt;
