			&lt;select type="Ability Score Improvement" name="Ability Score Increase (Mounted Combatant)" supports="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_FEAT_STRENGTH|ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_FEAT_DEXTERITY|ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_FEAT_WISDOM" /&gt;
		&lt;/rules&gt;
	&lt;/element&gt;

