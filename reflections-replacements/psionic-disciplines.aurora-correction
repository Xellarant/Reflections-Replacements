    &lt;info&gt;
        &lt;name&gt;KibblesTasty’s Psion Psionic Disciplines&lt;/name&gt;
        &lt;update version="0.0.1"&gt;
            &lt;file name="psionic-disciplines.xml" url="https://raw.githubusercontent.com/community-elements/elements-reddit/master/reddit/reddit-unearthed-arcana/kibblestasty/psion/psionic-disciplines.xml" /&gt;
