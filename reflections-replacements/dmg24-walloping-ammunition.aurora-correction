	&amp;lt;element name="Weapon, +3" type="Magic Item" source="Dungeon Master’s Guide (2024)" id="ID_WOTC_DMG24_MAGIC_ITEM_WEAPON_3"&amp;gt;
		&amp;lt;description&amp;gt;
