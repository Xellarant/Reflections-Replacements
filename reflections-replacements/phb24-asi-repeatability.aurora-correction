	&lt;element name="Ability Score Improvement" type="Feat" source="Player’s Handbook (2024)" id="ID_WOTC_PHB24_FEAT_ABILITY_SCORE_IMPROVEMENT"&gt;
		&lt;requirements&gt;[character:4]||ID_WOTC_PHB24_GRANTS_FEAT_UNLOCKER&lt;/requirements&gt;
		&lt;prerequisite&gt;Level 4+&lt;/prerequisite&gt;
		&lt;supports&gt;General&lt;/supports&gt;
		&lt;description&gt;
			&lt;p class="flavor"&gt;General Feat (Prerequisite: Level 4+)&lt;/p&gt;
			&lt;p&gt;Increase one ability score of your choice by 2, or increase two ability scores of your choice by 1. This feat can't increase an ability score above 20.&lt;/p&gt;
			&lt;p class="indent"&gt;&lt;b&gt;&lt;i&gt;Repeatable.&lt;/i&gt;&lt;/b&gt; You can take this feat more than once.&lt;/p&gt;
		&lt;/description&gt;
		&lt;sheet display="false" /&gt;
		&lt;setters&gt;&lt;set name="allow duplicate"&gt;true&lt;/set&gt;&lt;/setters&gt;
		&lt;rules&gt;
			&lt;select type="Ability Score Improvement" name="Ability Score Improvement Feat" supports="Feat Ability Score Increase" number="2" /&gt;
		&lt;/rules&gt;
	&lt;/element&gt;
