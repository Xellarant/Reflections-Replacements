	&amp;lt;info&amp;gt;
		&amp;lt;name&amp;gt;The Spiritualist&amp;lt;/name&amp;gt;
		&amp;lt;update version="0.0.3"&amp;gt;
			&amp;lt;file name="class-spiritualist.xml" url="https://raw.githubusercontent.com/aurorabuilder/elements/master/third-party/dms-guild/classes/class-spiritualist.xml" /&amp;gt;
