		&lt;requirements&gt;([character:4],!(ID_WOTC_UA20200713_FEAT_CRUSHER||ID_WOTC_TCOE_FEAT_CRUSHER))||ID_WOTC_PHB24_GRANTS_FEAT_UNLOCKER&lt;/requirements&gt;
