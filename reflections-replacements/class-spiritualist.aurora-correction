			&amp;lt;description&amp;gt;&amp;lt;/description&amp;gt;
		&amp;lt;/sheet&amp;gt;
		&amp;lt;rules&amp;gt;
			&amp;lt;grant type="Spell" id="ID_PHB_SPELL_DISGUISE_SELF" level="2" spellcasting="Spiritualist" prepared="true" /&amp;gt;
