&lt;elements&gt;
    &lt;info&gt;
        &lt;name&gt;Devout Martial Archetype&lt;/name&gt;
        &lt;update version="0.0.1"&gt;
            &lt;file name="fighter-devout.xml" url="https://raw.githubusercontent.com/community-elements/elements-reddit/master/reddit/reddit-unearthed-arcana/blazing-dawn-players-companion/fighter-devout.xml" /&gt;
