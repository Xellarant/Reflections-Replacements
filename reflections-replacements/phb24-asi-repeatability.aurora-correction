			&amp;lt;select type="Feat Feature" name="Ability Score Increase (Shadow-Touched)" supports="PHB24 Shadow-Touched" /&amp;gt;
			&amp;lt;grant type="Spell" id="ID_WOTC_PHB24_SPELL_INVISIBILITY" /&amp;gt;
			&amp;lt;select type="Spell" name="Spell (Shadow-Touched)" supports="1,(Illusion||Necromancy)" /&amp;gt;
		&amp;lt;/rules&amp;gt;
	&amp;lt;/element&amp;gt;
