	&lt;element name="Staff of Healing" type="Magic Item" source="Dungeon Master’s Guide (2024)" id="ID_WOTC_DMG24_MAGIC_ITEM_STAFF_OF_HEALING"&gt;
		&lt;description&gt;
			&lt;p&gt;This staff has 10 charges. While holding the staff, you can cast one of the spells on the following table from it, using your spellcasting ability modifier. The table indicates how many charges you must expend to cast the spell.&lt;/p&gt;
			&lt;table&gt;
				&lt;thead&gt;
					&lt;tr&gt;&lt;td&gt;Spell&lt;/td&gt;&lt;td&gt;Charge Cost&lt;/td&gt;&lt;/tr&gt;
				&lt;/thead&gt;
				&lt;tr&gt;&lt;td&gt;&lt;i&gt;Cure Wounds&lt;/i&gt;&lt;/td&gt;&lt;td&gt;1 per spell level (maximum 4 for a level 4 spell)&lt;/td&gt;&lt;/tr&gt;
				&lt;tr&gt;&lt;td&gt;&lt;i&gt;Lesser Restoration&lt;/i&gt;&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;
