	&lt;info&gt;
		&lt;update version="0.0.1"&gt;
			&lt;file name="wizard-demonbinder.xml" url="https://raw.githubusercontent.com/aurorabuilder/elements/master/third-party/dms-guild/the-great-dale/archetypes/wizard-demonbinder.xml" /&gt;
