		&amp;lt;rules&amp;gt;
			&amp;lt;select type="Spell" name="Enspelled Staff (Level 6)" supports="6" /&amp;gt;
		&amp;lt;/rules&amp;gt;
	&amp;lt;/element&amp;gt;

	&amp;lt;element name="Enspelled Staff (Level 7)" type="Magic Item" source="Dungeon Master’s Guide (2024)" id="ID_WOTC_DMG24_MAGIC_ITEM_ENSPELLED_STAFF_LEVEL_7"&amp;gt;
