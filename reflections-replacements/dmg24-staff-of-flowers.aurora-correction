			&lt;set name="keywords"&gt;bard, cleric, druid, sorcerer, warlock, wizard, charge, recharges, dawn, magic action, action, heavily obscured, giant insect, insect plague&lt;/set&gt;
			&lt;set name="category"&gt;Magic Weapons&lt;/set&gt;
