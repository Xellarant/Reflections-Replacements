		&lt;supports&gt;PHB24 Resilient&lt;/supports&gt;
		&lt;requirements&gt;!ID_PROFICIENCY_SAVINGTHROW_STRENGTH&lt;/requirements&gt;
		&lt;compendium display="false" /&gt;
		&lt;description&gt;
			&lt;p&gt;You gain proficiency with Strength saving throws, and increase your Strength by 1, to a maximum of 20.&lt;/p&gt;
		&lt;/description&gt;
		&lt;sheet display="false" /&gt;
		&lt;rules&gt;
			&lt;stat name="strength" value="1" alt="Resilient" /&gt;
			&lt;stat name="strength:save:proficiency" value="proficiency" bonus="proficiency" alt="Proficiency" /&gt;
		&lt;/rules&gt;
	&lt;/element&gt;
