	&lt;element name="Enspelled Staff (Level 7)" type="Magic Item" source="Dungeon Master’s Guide (2024)" id="ID_WOTC_DMG24_MAGIC_ITEM_ENSPELLED_STAFF_LEVEL_7"&gt;
