		&amp;lt;/rules&amp;gt;
	&amp;lt;/element&amp;gt;

	&amp;lt;element name="Enspelled Weapon (Level 7)" type="Magic Item" source="Dungeon Master’s Guide (2024)" id="ID_WOTC_DMG24_MAGIC_ITEM_ENSPELLED_WEAPON_LEVEL_7"&amp;gt;
