  <rr:proposal schema-version="1" id="mordenkainens-tome-rarity-typos" revision="1.0.0">
    <rr:title>Mordenkainen's Tome rarity typos</rr:title>
    <rr:summary>Correct the rarities Vert Rare (Crown of Leadership) and Lgendary (Rattle of Death) to Very Rare and Legendary.</rr:summary>
    <rr:variant source-path="third-party/dms-guild/mordenkainens-tome-of-marvelous-magic.xml" source-sha256="F34B1D47B26FCAA2A4F882964F41FA224C25914736973C2ECD001FC202792816">
