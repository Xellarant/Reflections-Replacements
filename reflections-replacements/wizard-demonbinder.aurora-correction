		&lt;/description&gt;
		&lt;setters&gt;
			&lt;set name="keywords"&gt;amulet, necklace, demon&lt;/set&gt;
			&lt;set name="category"&gt;Adventuring Gear&lt;/set&gt;
			&lt;set name="cost" currency="gp"&gt;50&lt;/set&gt;
			&lt;set name="weight" lb="1"&gt;1 lb.&lt;/set&gt;
			&lt;set name="type"&gt;Amulet&lt;/set&gt;
			&lt;set name="slot"&gt;neck&lt;/set&gt;
		&lt;/setters&gt;
	&lt;/element&gt;	
