    &amp;lt;element name="Stoneheart Sorcerer" type="Source" source="Core" id="ID_KIBBLESTASTY_GMBINDER_SOURCE_STONEHEART"&amp;gt;
        &amp;lt;description&amp;gt;
            &amp;lt;![CDATA[&amp;lt;p&amp;gt;&amp;lt;/p&amp;gt;]]&amp;gt;
        &amp;lt;/description&amp;gt;
        &amp;lt;setters&amp;gt;
