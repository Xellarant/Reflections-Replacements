&lt;elements&gt;
	&lt;info&gt;
		&lt;name&gt;Origin Feats&lt;/name&gt;
		&lt;update version="0.0.1"&gt;
			&lt;file name="feats-origin.xml" url="https://raw.githubusercontent.com/AuroraLegacy/elements/master/core/players-handbook-2024/feats/feats-origin.xml" /&gt;
