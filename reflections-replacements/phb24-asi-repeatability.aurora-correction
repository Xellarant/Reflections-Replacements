			&amp;lt;select type="Ability Score Improvement" name="Ability Score Increase (Dual Wielder)" supports="ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_FEAT_STRENGTH|ID_INTERNAL_ABILITY_SCORE_IMPROVEMENT_FEAT_DEXTERITY" /&amp;gt;
