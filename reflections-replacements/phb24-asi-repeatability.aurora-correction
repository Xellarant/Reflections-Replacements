		&lt;supports&gt;General&lt;/supports&gt;
		&lt;requirements&gt;([character:4],ID_PROFICIENCY_ARMOR_PROFICIENCY_HEAVY_ARMOR,!ID_PHB_FEAT_HEAVYARMORMASTER)||ID_WOTC_PHB24_GRANTS_FEAT_UNLOCKER&lt;/requirements&gt;
