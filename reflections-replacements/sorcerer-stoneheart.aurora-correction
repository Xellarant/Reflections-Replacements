        &lt;description&gt;
            &lt;![CDATA[&lt;p&gt;&lt;/p&gt;]]&gt;
        &lt;/description&gt;
        &lt;setters&gt;
            &lt;set name="abbreviation"&gt;SS&lt;/set&gt;
