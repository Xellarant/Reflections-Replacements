	&amp;lt;element name="Enspelled Weapon (Level 6)" type="Magic Item" source="Dungeon Master’s Guide (2024)" id="ID_WOTC_DMG24_MAGIC_ITEM_ENSPELLED_WEAPON_LEVEL_6"&amp;gt;
