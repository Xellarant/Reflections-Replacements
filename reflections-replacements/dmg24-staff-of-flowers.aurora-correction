			&amp;lt;set name="rarity"&amp;gt;Legendary&amp;lt;/set&amp;gt;
			&amp;lt;set name="attunement" addition="by Sorcerer, Warlock, or Wizard"&amp;gt;true&amp;lt;/set&amp;gt;
			&amp;lt;set name="enhancement"&amp;gt;2&amp;lt;/set&amp;gt;
