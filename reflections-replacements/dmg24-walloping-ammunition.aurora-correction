	&lt;element name="Adamantine Weapon" type="Magic Item" source="Dungeon Master’s Guide (2024)" id="ID_WOTC_DMG24_MAGIC_ITEM_ADAMANTINE_WEAPON"&gt;
		&lt;description&gt;
			&lt;p&gt;This weapon is made of adamantine, one of the hardest substances in existence. Whenever this weapon or piece of ammunition hits an object, the hit is a Critical Hit.&lt;/p&gt;
		&lt;/description&gt;
		&lt;setters&gt;
			&lt;set name="category"&gt;Magic Weapons&lt;/set&gt;
			&lt;set name="type" addition="Any"&gt;Melee Weapon&lt;/set&gt;
			&lt;set name="weapon"&gt;ID_INTERNAL_WEAPON_CATEGORY_SIMPLE_MELEE||ID_INTERNAL_WEAPON_CATEGORY_MARTIAL_MELEE||&lt;/set&gt;
			&lt;set name="rarity"&gt;Uncommon&lt;/set&gt;
			&lt;set name="cost" currency="gp"&gt;400&lt;/set&gt;
			&lt;set name="name-format"&gt;Adamantine {{parent}}&lt;/set&gt;
		&lt;/setters&gt;
	&lt;/element&gt;

	&lt;element name="Adamantine Ammunition" type="Magic Item" source="Dungeon Master’s Guide (2024)" id="ID_WOTC_DMG24_MAGIC_ITEM_AMMUNITION_ADAMANTINE"&gt;
		&lt;description&gt;
			&lt;p&gt;This piece of ammunition is made of adamantine, one of the hardest substances in existence. Whenever this weapon or piece of ammunition hits an object, the hit is a Critical Hit.&lt;/p&gt;
		&lt;/description&gt;
		&lt;setters&gt;
			&lt;set name="keywords"&gt;arrow, bolt, bullet&lt;/set&gt;
			&lt;set name="category"&gt;Ammunition&lt;/set&gt;
