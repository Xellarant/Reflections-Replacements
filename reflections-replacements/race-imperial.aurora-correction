			&lt;set name="names" type="male"&gt;Emerald, Lime, Cheery, Azure, Ruby, Pride, Bashful, Slippy, Wobblence, Wiggilium, Jade, Mercury&lt;/set&gt;
			&lt;set name="names" type="female"&gt;Emerald, Lime, Cheery, Azure, Ruby, Pride, Bashful, Slippy, Wobblence, Wiggilium, Jade, Mercury&lt;/set&gt;
