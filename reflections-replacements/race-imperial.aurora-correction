            &amp;lt;grant type="Racial Trait" id="ID_GFP_COFSA_RACIAL_TRAIT_VIPER_FANGS" /&amp;gt;
            &amp;lt;grant type="Racial Trait" id="ID_GFP_COFSA_RACIAL_TRAIT_FORM_SUPRESSION" /&amp;gt;
            &amp;lt;grant type="Racial Trait" id="ID_GFP_COFSA_RACIAL_TRAIT_FORKED_TONGUE" /&amp;gt;
            &amp;lt;select type="Racial Trait" name="Racial Origin" supports="Alfallen Origin Race" /&amp;gt;
		&amp;lt;/rules&amp;gt;
	&amp;lt;/element&amp;gt;
	
    &amp;lt;element name="Dexterity" type="Racial Trait" source="The Compendium of Forgotten Secrets" id="ID_GFP_COFSA_RACIAL_TRAIT_IMPERIAL_DEXTERITY"&amp;gt;
        &amp;lt;description&amp;gt;
            &amp;lt;p&amp;gt;Your Dexterity score increases by 2, and your Wisdom score increases by 1.&amp;lt;/p&amp;gt;
