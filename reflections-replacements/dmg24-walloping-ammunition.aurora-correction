			&amp;lt;set name="rarity"&amp;gt;Uncommon&amp;lt;/set&amp;gt;
			&amp;lt;set name="attunement"&amp;gt;true&amp;lt;/set&amp;gt;
			&amp;lt;set name="cost" currency="gp"&amp;gt;400&amp;lt;/set&amp;gt;
