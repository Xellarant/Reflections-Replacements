	&amp;lt;/element&amp;gt;
	&amp;lt;element name="Wisdom" type="Feat Feature" source="Player’s Handbook (2024)" id="ID_WOTC_PHB24_FEAT_FEATURE_INSPIRING_LEADER_WISDOM"&amp;gt;
